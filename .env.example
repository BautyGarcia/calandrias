# dbm (Postgres + better-auth + S3) — valores desde `dbm env calandrias`
DATABASE_URL=
DATABASE_URL_SESSION=     # solo migraciones (drizzle-kit)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://admin.calandrias.com.ar   # solo producción; en preview/local dejar vacío
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=calandrias
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://calandrias.web.bautygarcia.com   # bucket público (dbm storage public)

# Admin
ADMIN_EMAILS=            # emails separados por coma con acceso al backoffice (allowlist de alta y login)

# MercadoPago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=reservas@calandrias.com.ar

# Cron (solo server)
CRON_SECRET=

# Sitio
NEXT_PUBLIC_SITE_URL=https://calandrias.com.ar
NEXT_PUBLIC_ADMIN_URL=https://admin.calandrias.com.ar

# Analytics
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_GTM_ID=
